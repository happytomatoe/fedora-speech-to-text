{
  "test-suites": {
    "transcription": {
      "description": "Core transcription tests with different audio files and output methods",
      "enabled": true,
      "matrix": {
        "audio-files": [
          {
            "id": "audio-01",
            "file": "test-01-weather.wav",
            "expected": "the weather to nadin sunny with a high on 75 degrees",
            "category": "weather"
          },
          {
            "id": "audio-02",
            "file": "test-02-reminder.wav",
            "expected": "remember to buy groceries after work today",
            "category": "reminder"
          },
          {
            "id": "audio-03",
            "file": "test-03-hello.wav",
            "expected": "good morning, how are you today?",
            "category": "greeting"
          },
          {
            "id": "audio-04",
            "file": "test-04-calendar.wav",
            "expected": "our meeting is scheduled for 3pm on monday",
            "category": "calendar"
          },
          {
            "id": "audio-05",
            "file": "test-05-note.wav",
            "expected": "take a note that the project deadline is next friday",
            "category": "note"
          }
        ],
        "output-methods": [
          {
            "id": "type",
            "name": "Dotool Type",
            "description": "Types via dotool (requires dotoolc)",
            "enabled": true,
            "requires": ["dotoolc"]
          },
          {
            "id": "mutter-virtual",
            "name": "Mutter Virtual",
            "description": "Char-by-char typing via GNOME extension D-Bus (virtual keyboard)",
            "enabled": true,
            "requires": ["gnome-extension"]
          },
          {
            "id": "mutter-commit",
            "name": "Mutter Commit",
            "description": "Commits text via Main.inputMethod.commit()",
            "enabled": true,
            "requires": ["gnome-extension"]
          }
        ]
      },
      "test-cases": [
        {
          "id": "T01",
          "audio": "audio-01",
          "output-method": "type",
          "priority": "high",
          "description": "Weather transcription with dotool type"
        },
        {
          "id": "T02",
          "audio": "audio-01",
          "output-method": "mutter-virtual",
          "priority": "medium",
          "description": "Weather transcription with mutter virtual"
        },
        {
          "id": "T03",
          "audio": "audio-01",
