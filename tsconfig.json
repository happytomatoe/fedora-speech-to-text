{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["@girs/gjs"],
    "paths": {
      "gi://Gtk": ["./node_modules/@girs/gtk-4.0"],
      "gi://Adw": ["./node_modules/@girs/adw-1"],
      "gi://Gio": ["./node_modules/@girs/gio-2.0"],
      "gi://GLib": ["./node_modules/@girs/glib-2.0"],
      "gi://Gdk": ["./node_modules/@girs/gdk-4.0"],
      "gi://GObject": ["./node_modules/@girs/gobject-2.0"],
      "gi://GdkPixbuf": ["./node_modules/@girs/gdkpixbuf-2.0"],
      "gi://Pango": ["./node_modules/@girs/pango-1.0"],
      "gi://cairo": ["./node_modules/@girs/cairo-1.0"]
    }
  },
  "include": ["gnome-ext/**/*.js", "gnome-ext/**/*.d.ts"],
  "exclude": ["node_modules", "gnome-ext/dist", "gnome-ext/js-yaml.mjs"]
}
